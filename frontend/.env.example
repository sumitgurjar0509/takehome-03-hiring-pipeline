# Copy this file to .env and fill in real values. Never commit .env itself.
# Vite only exposes env vars prefixed VITE_ to client-side code.

# Base URL of the backend API. In dev this can be omitted entirely — the
# axios client (src/api/client.js) falls back to http://localhost:8000. In
# production, set this to the deployed Render service's URL, e.g.
# https://hiring-pipeline-api.onrender.com — no trailing slash.
VITE_API_URL=http://localhost:8000
