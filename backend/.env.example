# Copy this file to .env and fill in real values. Never commit .env itself.

# SQLAlchemy connection string for PostgreSQL.
# Local dev example:
DATABASE_URL=postgresql+psycopg2://hiring_pipeline:devpassword@localhost:5432/hiring_pipeline

# Secret used to sign JWTs. Generate a random 32+ byte string for real deployments,
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Comma-separated list of origins allowed to call the API (the deployed frontend URL(s)).
CORS_ORIGINS=http://localhost:5173
